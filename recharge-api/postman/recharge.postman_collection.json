{
  "info": {
    "name": "Recharge API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const d = new Date(Date.now() + 7*24*3600*1000);",
          "const day = d.toISOString().slice(0,10);",
          "pm.collectionVariables.set('debut', day + 'T10:00:00');",
          "pm.collectionVariables.set('fin', day + 'T12:00:00');",
          "pm.collectionVariables.set('debutChev', day + 'T11:00:00');",
          "pm.collectionVariables.set('finChev', day + 'T13:00:00');",
          "pm.collectionVariables.set('email', 'sara' + Date.now() + '@mail.com');",
          "pm.collectionVariables.set('immat', 'TUN' + Date.now());",
          "pm.collectionVariables.set('codeBorne', 'B-' + Date.now());"
        ]
      }
    }
  ],
